# ---------------------------------------------------------------
# SliqDesk environment - copy to .env and change the secrets.
# Never commit .env. Frontend build receives NONE of these values.
# ---------------------------------------------------------------

# PostgreSQL container
POSTGRES_DB=sliqdesk_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Backend / worker database connection (DB_HOST is forced to "postgres" inside compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sliqdesk_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false

BACKEND_PORT=5000

# JWT: RS256. The key pair is generated on first start into the jwt_keys volume,
# or injected from a secret store (e.g. Azure Key Vault) as base64-encoded PEM:
# JWT_PRIVATE_KEY_B64=
# JWT_PUBLIC_KEY_B64=
JWT_EXPIRES_IN=60m

COOKIE_NAME=sliqdesk_token
CSRF_COOKIE_NAME=sliqdesk_csrf
# COOKIE_SECURE defaults to true when NODE_ENV=production (requires HTTPS)

SLA_POLL_INTERVAL_MS=30000
DEFAULT_SLA_MINUTES=5

INVITATION_EXPIRES_HOURS=72
AUTH_RATE_LIMIT_MAX=20

FRONTEND_URL=http://localhost:3000
# Allowed browser origins (comma separated). 5173 = Vite dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Host port mappings (change if a port is already in use on your machine)
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=5000
POSTGRES_HOST_PORT=5432
